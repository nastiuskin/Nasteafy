{
  // Move all keys and connection strings into a safe place, easy one to use is User Secrets, even if it is development data it is not recommended to have them in settings 
  // https://learn.microsoft.com/en-us/aspnet/core/security/app-secrets?view=aspnetcore-9.0&tabs=windows
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "JwtOptions": {
    "Audience": "NasteafyClient",
    "Issuer": "Nasteafy",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "MinioOptions": {
    "Buckets": {
      "Image": {
        "Name": "image-bucket",
        "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".jfif" ]
      },
      "Audio": {
        "Name": "audio-bucket",
        "AllowedExtensions": [ ".mp3", ".wav", ".flac", ".ogg" ]
      }
    },
    "IdentitySettings": {
      "Password": {
        "RequiredLength": 8,
        "RequireDigit": false,
        "RequireNonAlphanumeric": false,
        "RequireUppercase": false
      }
    },
    "AllowedHosts": "*"
  }
}
